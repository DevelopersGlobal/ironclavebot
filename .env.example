# Copy to .env. Real environment variables take precedence over this file.

# LLM provider: mock | openai | ollama
LLM_PROVIDER=mock
LLM_MODEL=mock-agent
# OPENAI_API_KEY=your_key_here
# OLLAMA_BASE_URL=http://localhost:11434

# Dashboard
PORT=8080
# Listens on loopback only by default. A non-loopback HOST requires API_TOKEN.
# HOST=127.0.0.1
# API_TOKEN=change-me-to-a-long-random-string

# interactive (default) and strict refuse command execution and file writes
# until an approval mechanism exists. permissive allows them; use it only
# inside a container or VM.
SECURITY_MODE=interactive
